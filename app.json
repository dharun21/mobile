{
  "expo": {
    "name": "Zengen AI",
    "slug": "zengenai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "zengenai",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.zengen.workspace"
    },
    "android": {
      "package": "ai.zengen.workspace",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store",
      "expo-document-picker",
      "expo-status-bar",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Zengen AI to list your calendars and keep your finance reminders in the calendar you choose."
        }
      ]
    ]
  }
}
